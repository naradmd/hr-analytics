              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birthdate], TODAY())' />
            </column>
            <column caption='Age Groups' datatype='string' name='[Calculation_0646565663195137]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_0646565662445568] &lt; 25 THEN &apos;&lt;25&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=25 AND [Calculation_0646565662445568]&lt;35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=35 AND [Calculation_0646565662445568]&lt;45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=45 AND [Calculation_0646565662445568]&lt;55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=55 THEN &apos;55+&apos; END' />
