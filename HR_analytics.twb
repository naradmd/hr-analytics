      <aliases enabled='yes' />
      <column caption='% of Total Hired' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0907424239575040] / TOTAL([Calculation_0907424239575040])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_0646565662445568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birthdate], TODAY())' />
      </column>
      <column caption='Age Groups' datatype='string' name='[Calculation_0646565663195137]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0646565662445568] &lt; 25 THEN &apos;&lt;25&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=25 AND [Calculation_0646565662445568]&lt;35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=35 AND [Calculation_0646565662445568]&lt;45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=45 AND [Calculation_0646565662445568]&lt;55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF [Calculation_0646565662445568]&gt;=55 THEN &apos;55+&apos; END' />
      </column>
      <column caption='Total Hired' datatype='integer' name='[Calculation_0907424239575040]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee_ID])' />
      </column>
      <column caption='Total Terminated' datatype='integer' name='[Calculation_0907424243212289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF NOT ISNULL([Termdate]) THEN [Employee_ID] END)' />
      </column>
      <column caption='Total active' datatype='integer' name='[Calculation_0907424244731906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF ISNULL([Termdate])    THEN [Employee_ID]    END)' />
      </column>
      <column caption='Location' datatype='string' name='[Calculation_0907424258682883]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [State]&#13;&#10;    WHEN &apos;New York&apos; THEN &apos;HQ&apos;&#13;&#10;    ELSE &apos;Branch&apos;&#13;&#10;END' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_0914571763367936]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &apos;Hired&apos;&#13;&#10;ELSE &apos;Terminated&apos;&#13;&#10;END' />
      </column>
      <column caption='Highlight Max' datatype='boolean' name='[Calculation_0914571770122241]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_0907424239575040]) = [Calculation_0907424239575040]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
